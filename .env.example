# Copy this file to .env (for local `vercel dev`) — .env is gitignored and never committed.
# In production, set these in the Vercel dashboard: Project Settings -> Environment Variables.
# Get your key from https://console.anthropic.com

ANTHROPIC_API_KEY=

# Same project URL and publishable (anon) key already embedded client-side in
# MyBizExco_21.html (SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY) — not secret,
# safe to have here. Used by /api/claude.js to validate the caller's session
# via Supabase Auth (GET /auth/v1/user).
SUPABASE_URL=https://xqkcjurfvhzpehdawint.supabase.co
SUPABASE_ANON_KEY=sb_publishable_Hv48ZAC0TG1gMz6D23f2XQ_Yd9NmWGb

# SECRET — Supabase Dashboard -> Project Settings -> API -> service_role key.
# Bypasses Row Level Security entirely. Server-side only, same as
# ANTHROPIC_API_KEY — never expose this to the browser or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=
